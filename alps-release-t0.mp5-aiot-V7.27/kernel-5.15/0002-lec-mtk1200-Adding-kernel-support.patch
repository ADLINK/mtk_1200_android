+        ret = snd_soc_dai_set_sysclk(codec_dai, 0, mclk_fs,tx ? SND_SOC_CLOCK_OUT : SND_SOC_CLOCK_IN);
+
+        if (ret) {
+                dev_err(card->dev, "failed to set codec sysclk\n");
+                return ret;
+        }
+#endif
+
+        return 0;
+}
