+#ifdef STA_SUPPORT
+/** Region code mapping */
+typedef struct _region_code_mapping {
+	/** Region */
+	t_u8 region[COUNTRY_CODE_LEN];
+	/** Code */
+	t_u8 code;
+} region_code_mapping_t;
+
+/** Region code mapping table */
+static region_code_mapping_t region_code_mapping[] = {
+	{"US ", 0x10}, /* US FCC      */
+	{"CA ", 0x20}, /* IC Canada   */
+	{"SG ", 0x10}, /* Singapore   */
+	{"EU ", 0x30}, /* ETSI        */
+	{"AU ", 0x30}, /* Australia   */
+	{"KR ", 0x30}, /* Republic Of Korea */
+	{"FR ", 0x32}, /* France      */
+	{"JP ", 0x40}, /* Japan       */
