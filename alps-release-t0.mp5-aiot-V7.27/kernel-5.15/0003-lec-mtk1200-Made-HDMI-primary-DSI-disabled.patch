From 3bfe70bc9d08d564bc7b1961a65d5cb54be288fd Mon Sep 17 00:00:00 2001
From: shiva-adlink <shivashankar.t@adlinktech.com>
Date: Tue, 24 Jun 2025 22:58:25 +0530
Subject: [PATCH 3/3] lec-mtk1200: Made-HDMI-primary-DSI-disabled

Signed-off-by: shiva-adlink <shivashankar.t@adlinktech.com>
---
 arch/arm64/boot/dts/mediatek/aiot8395p1_64_bsp.dts   | 4 ++--
 arch/arm64/configs/aiot8395p1_64_bsp_debug_defconfig | 1 +
 arch/arm64/configs/aiot8395p1_64_bsp_defconfig       | 1 +
 3 files changed, 4 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/mediatek/aiot8395p1_64_bsp.dts b/arch/arm64/boot/dts/mediatek/aiot8395p1_64_bsp.dts
index 91ee8720c..8a5cadded 100644
--- a/arch/arm64/boot/dts/mediatek/aiot8395p1_64_bsp.dts
+++ b/arch/arm64/boot/dts/mediatek/aiot8395p1_64_bsp.dts
@@ -426,7 +426,7 @@ dpi1_out: endpoint@0 {
 };
 
 &disp_dsi0 {
-	status = "okay";
+	status = "disabled";
 	#address-cells = <1>;
 	#size-cells = <0>;
 	panel@0 {
@@ -439,7 +439,7 @@ panel@0 {
 		pinctrl-names = "default";
 		pinctrl-0 = <&panel_pins_default>;
 		pp1800-supply = <&mt_pmic_vtp_ldo_reg>;
-		status = "okay";
+		status = "disabled";
 		dsi-lanes = <4>;
 		video-mode = <0>;
 		panel-width-mm = <293>;
diff --git a/arch/arm64/configs/aiot8395p1_64_bsp_debug_defconfig b/arch/arm64/configs/aiot8395p1_64_bsp_debug_defconfig
index ac9037059..11800658c 100644
--- a/arch/arm64/configs/aiot8395p1_64_bsp_debug_defconfig
+++ b/arch/arm64/configs/aiot8395p1_64_bsp_debug_defconfig
@@ -188,6 +188,7 @@ CONFIG_DRM_PANEL_AUO_B101UAN1V7=m
 CONFIG_DRM_MEDIATEK_PANEL=m
 CONFIG_DRM_MEDIATEK=m
 CONFIG_DRM_MEDIATEK_V2=y
+CONFIG_MTK_SUB_AS_MAIN=y
 CONFIG_DRM_MEDIATEK_HDMI=m
 CONFIG_DRM=y
 # CONFIG_DRM_MEDIATEK_HDMI_HDCP is not set
diff --git a/arch/arm64/configs/aiot8395p1_64_bsp_defconfig b/arch/arm64/configs/aiot8395p1_64_bsp_defconfig
index 241043fc9..c433a7897 100644
--- a/arch/arm64/configs/aiot8395p1_64_bsp_defconfig
+++ b/arch/arm64/configs/aiot8395p1_64_bsp_defconfig
@@ -188,6 +188,7 @@ CONFIG_DRM_PANEL_AUO_B101UAN1V7=m
 CONFIG_DRM_MEDIATEK_PANEL=m
 CONFIG_DRM_MEDIATEK=m
 CONFIG_DRM_MEDIATEK_V2=y
+CONFIG_MTK_SUB_AS_MAIN=y
 CONFIG_DRM_MEDIATEK_HDMI=m
 # CONFIG_DRM_MEDIATEK_HDMI_HDCP is not set
 CONFIG_MTK_GATE_IC=y
-- 
2.34.1

