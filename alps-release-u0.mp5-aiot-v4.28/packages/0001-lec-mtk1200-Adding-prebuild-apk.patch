index 000000000..e06fae016
--- /dev/null
+++ b/Chrome/Android.mk
@@ -0,0 +1,20 @@
+LOCAL_PATH := $(call my-dir)
+
+include $(CLEAR_VARS)
+LOCAL_MODULE := Chrome
